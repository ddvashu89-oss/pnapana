# Never serve dotfiles (.env, .git, .htaccess) or the repo's own metadata.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
