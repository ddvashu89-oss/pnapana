# Nothing in backend/ should be fetchable except the API endpoints in backend/api/.
# PHP files are executed rather than served, so their source does not leak by
# default -- but a server with PHP disabled or misconfigured would hand out
# config.php in plain text, secrets and all. This makes that impossible.

# Block direct access to every file at this level (config.php, db.php,
# cors.php, jwt_helper.php, schema.sql, ...).
<FilesMatch "(\.(php|sql|md|example|log|ini|json)$|^\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Never serve a directory index anywhere under backend/.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# setup_admin.php is the one exception: shared hosting has no SSH, so the first
# admin has to be created over HTTP. It guards itself three ways (refuses once
# an admin exists, requires SETUP_KEY, tells you to delete it) and is meant to
# be removed from the server immediately after use.
<Files "setup_admin.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>
