# backend/.htaccess denies PHP at the parent level; the API endpoints live here
# and must stay reachable, so re-allow them for this directory only.
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# auth.php is an include, never an endpoint. Requesting it directly would run it
# with no request context.
<Files "auth.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
